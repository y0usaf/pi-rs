{
  "prompts": [
    "what changes are uncommitted?"
  ],
  "files": {
    "notes.txt": "before\n",
    "dirty.txt": "uncommitted work\n"
  },
  "setup": [
    [
      "git",
      "init",
      "--initial-branch=main"
    ],
    [
      "git",
      "config",
      "user.name",
      "Parity"
    ],
    [
      "git",
      "config",
      "user.email",
      "parity@example.invalid"
    ],
    [
      "git",
      "add",
      "notes.txt"
    ],
    [
      "git",
      "commit",
      "-m",
      "seed"
    ],
    [
      "git",
      "add",
      "--intent-to-add",
      "dirty.txt"
    ]
  ],
  "turns": [
    {
      "text": "A new file changed"
    }
  ]
}
