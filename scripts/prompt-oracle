#!/usr/bin/env bash
# Regenerate the prompt-template parity oracle from Pi's real
# prompt-templates.ts pure functions (parseCommandArgs, substituteArgs,
# expandPromptTemplate). Run via scripts/prompt-oracle. Offline normal checks
# consume the checked oracle; opt-in regeneration drives the pinned Pi source.
set -euo pipefail
cd "$(dirname "$0")/.."
cases=tests/prompt-parity/cases.json
oracle=tests/prompt-parity/oracle.json
if [[ ! -x ref/pi/node_modules/.bin/tsx ]]; then
  nix shell nixpkgs#nodejs_22 --command sh -c 'cd ref/pi && corepack npm ci --ignore-scripts'
fi
nix shell nixpkgs#nodejs_22 --command \
  ref/pi/node_modules/.bin/tsx --tsconfig ref/pi/tsconfig.json \
  tests/prompt-parity/gen-oracle.ts "$cases" "$oracle"
echo "wrote $oracle"