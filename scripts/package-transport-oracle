#!/usr/bin/env bash
# Regenerate the package-transport parity oracle from Pi's real utils/git.ts
# parseGitUrl + utils/paths.ts isLocalPath. Run via scripts/package-transport-oracle.
# Offline normal checks consume the checked oracle; opt-in regeneration drives
# the pinned Pi source.
set -euo pipefail
cd "$(dirname "$0")/.."
cases=tests/package-transport-parity/cases.json
oracle=tests/package-transport-parity/oracle.json
if [[ ! -x ref/pi/node_modules/.bin/tsx ]]; then
  nix shell nixpkgs#nodejs_22 --command sh -c 'cd ref/pi && corepack npm ci --ignore-scripts'
fi
nix shell nixpkgs#nodejs_22 --command \
  ref/pi/node_modules/.bin/tsx --tsconfig ref/pi/tsconfig.json \
  tests/package-transport-parity/gen-oracle.ts "$cases" "$oracle"
echo "wrote $oracle"