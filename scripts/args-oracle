#!/usr/bin/env bash
# Regenerate the args/help parity oracle from Pi's real `cli/args.ts`
# (parseArgs + printHelp) under the pinned Pi source. See tests/args-parity/.
#
# Run via scripts/args-oracle. Offline normal checks consume the checked
# oracle; opt-in regeneration drives the pinned Pi source.
set -euo pipefail
cd "$(dirname "$0")/.."
oracle=tests/args-parity/oracle.json
if [[ ! -x ref/pi/node_modules/.bin/tsx ]]; then
  nix shell nixpkgs#nodejs_22 --command sh -c 'cd ref/pi && corepack npm ci --ignore-scripts'
fi
ref/pi/node_modules/.bin/tsx --tsconfig ref/pi/tsconfig.json \
  tests/args-parity/gen-oracle.ts "$oracle"
echo "wrote $oracle"
