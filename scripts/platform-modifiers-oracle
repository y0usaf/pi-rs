#!/usr/bin/env bash
# Regenerate the platform-modifiers-parity oracle from Pi's real
# native-modifiers.ts + terminal.ts. See the sibling frontmatter-oracle.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ ! -x ref/pi/node_modules/.bin/tsx ]]; then
  echo "ref/pi/node_modules missing tsx; run npm ci in ref/pi" >&2
  exit 1
fi
nix shell nixpkgs#nodejs_22 --command \
  ref/pi/node_modules/.bin/tsx --tsconfig ref/pi/tsconfig.json \
  tests/platform-modifiers-parity/gen-oracle.ts \
  tests/platform-modifiers-parity/oracle.json
echo "wrote tests/platform-modifiers-parity/oracle.json"